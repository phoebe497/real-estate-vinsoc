# Production template for /etc/ocean-park/prod.env on AWS EC2.
APP_ENV=production
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_DB=ocean_park_production
POSTGRES_USER=ocean_production
POSTGRES_PASSWORD=replace-with-a-unique-production-database-password
DATABASE_URL=postgresql+psycopg://ocean_production:replace-with-a-unique-production-database-password@database:5432/ocean_park_production
AUTO_CREATE_TABLES=false
AUTO_SEED_CATALOG=true

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_EMAIL=admin@vsocintern.online
ADMIN_PASSWORD=replace-with-a-unique-production-admin-password
ADMIN_FULL_NAME=Production Administrator

CORS_ORIGINS=https://vsocintern.online
NEXT_PUBLIC_API_URL=https://api.vsocintern.online/api/v1
PROJECT_NAME=ocean-park-prod
DEPLOY_IMAGE_PREFIX=ghcr.io/phoebe497/real-estate-vinsoc
BACKEND_IMAGE=ghcr.io/phoebe497/real-estate-vinsoc-backend:prod-sha-0123456789abcdef0123456789abcdef01234567
FRONTEND_IMAGE=ghcr.io/phoebe497/real-estate-vinsoc-frontend:prod-sha-0123456789abcdef0123456789abcdef01234567
BACKEND_READY_URL=https://api.vsocintern.online/ready
FRONTEND_URL=https://vsocintern.online
FRONTEND_DOMAIN=vsocintern.online
API_DOMAIN=api.vsocintern.online
ACME_EMAIL=security@vsocintern.online

# Production receives larger limits; tune these from measured EC2 headroom.
DATABASE_CPU_LIMIT=1.50
DATABASE_MEMORY_LIMIT=2G
BACKEND_CPU_LIMIT=1.50
BACKEND_MEMORY_LIMIT=2G
FRONTEND_CPU_LIMIT=1.00
FRONTEND_MEMORY_LIMIT=1G

OPENAI_API_KEY=
LANGCHAIN_TRACING_V2=false
