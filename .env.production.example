# Production template. Copy to .env.production on the VPS and replace every placeholder.
APP_ENV=production
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_DB=ocean_park_production
POSTGRES_USER=ocean_production
POSTGRES_PASSWORD=replace-with-a-unique-production-database-password
DATABASE_URL=postgresql+psycopg://ocean_production:replace-with-a-unique-production-database-password@database:5432/ocean_park_production
AUTO_CREATE_TABLES=false
AUTO_SEED_CATALOG=true

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-production-admin-password
ADMIN_FULL_NAME=Production Administrator

CORS_ORIGINS=https://example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
# FRONTEND_PORT/BACKEND_PORT are retained for the legacy registry Compose path.
# The single-EC2 application stack does not publish application host ports.
FRONTEND_PORT=3000
BACKEND_PORT=8000
PROJECT_NAME=ocean-park-production
DEPLOY_IMAGE_PREFIX=ghcr.io/your-github-user-or-org/your-repo
BACKEND_IMAGE=ghcr.io/your-github-user-or-org/your-repo-backend:prod-sha-0123456789abcdef0123456789abcdef01234567
FRONTEND_IMAGE=ghcr.io/your-github-user-or-org/your-repo-frontend:prod-sha-0123456789abcdef0123456789abcdef01234567
BACKEND_READY_URL=https://api.example.com/ready
FRONTEND_URL=https://example.com
FRONTEND_DOMAIN=example.com
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# Production receives larger limits; tune these from measured EC2 headroom.
DATABASE_CPU_LIMIT=1.50
DATABASE_MEMORY_LIMIT=2G
BACKEND_CPU_LIMIT=1.50
BACKEND_MEMORY_LIMIT=2G
FRONTEND_CPU_LIMIT=1.00
FRONTEND_MEMORY_LIMIT=1G

OPENAI_API_KEY=
LANGCHAIN_TRACING_V2=false
