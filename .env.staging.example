# Staging template. Copy to .env.staging on the VPS and replace every placeholder.
APP_ENV=staging
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_DB=ocean_park_staging
POSTGRES_USER=ocean_staging
POSTGRES_PASSWORD=replace-with-a-unique-staging-database-password
DATABASE_URL=postgresql+psycopg://ocean_staging:replace-with-a-unique-staging-database-password@database:5432/ocean_park_staging
AUTO_CREATE_TABLES=false
AUTO_SEED_CATALOG=true

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_EMAIL=admin-staging@example.com
ADMIN_PASSWORD=replace-with-a-unique-staging-admin-password
ADMIN_FULL_NAME=Staging Administrator

CORS_ORIGINS=https://staging.example.com
NEXT_PUBLIC_API_URL=https://api-staging.example.com/api/v1
FRONTEND_PORT=3000
BACKEND_PORT=8000
PROJECT_NAME=ocean-park-staging
BACKEND_IMAGE=ghcr.io/your-github-user-or-org/your-repo-backend:dev
FRONTEND_IMAGE=ghcr.io/your-github-user-or-org/your-repo-frontend:dev
FRONTEND_DOMAIN=staging.example.com
API_DOMAIN=api-staging.example.com
ACME_EMAIL=admin@example.com

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_SITE_URL=https://staging.example.com
OPENROUTER_APP_NAME=Vinhomes AI Real Estate Advisor

# Alternative: official OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Alternative: any OpenAI-compatible gateway
# LLM_PROVIDER=custom
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
LANGCHAIN_TRACING_V2=false
