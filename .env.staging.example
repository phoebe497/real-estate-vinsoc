# Development/staging template for /etc/ocean-park/dev.env on AWS EC2.
APP_ENV=staging
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_DB=ocean_park_staging
POSTGRES_USER=ocean_staging
POSTGRES_PASSWORD=replace-with-a-unique-staging-database-password
DATABASE_URL=postgresql+psycopg://ocean_staging:replace-with-a-unique-staging-database-password@database:5432/ocean_park_staging
AUTO_CREATE_TABLES=false
AUTO_SEED_CATALOG=true

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_EMAIL=admin-dev@vsocintern.online
ADMIN_PASSWORD=replace-with-a-unique-staging-admin-password
ADMIN_FULL_NAME=Staging Administrator

CORS_ORIGINS=https://dev.vsocintern.online
NEXT_PUBLIC_API_URL=https://api-dev.vsocintern.online/api/v1
PROJECT_NAME=ocean-park-dev
DEPLOY_IMAGE_PREFIX=ghcr.io/phoebe497/real-estate-vinsoc
BACKEND_IMAGE=ghcr.io/phoebe497/real-estate-vinsoc-backend:dev-sha-0123456789abcdef0123456789abcdef01234567
FRONTEND_IMAGE=ghcr.io/phoebe497/real-estate-vinsoc-frontend:dev-sha-0123456789abcdef0123456789abcdef01234567
BACKEND_READY_URL=https://api-dev.vsocintern.online/ready
FRONTEND_URL=https://dev.vsocintern.online
FRONTEND_DOMAIN=dev.vsocintern.online
API_DOMAIN=api-dev.vsocintern.online
ACME_EMAIL=security@vsocintern.online

# Strict development ceilings protect production capacity on the shared EC2.
DATABASE_CPU_LIMIT=0.75
DATABASE_MEMORY_LIMIT=768M
BACKEND_CPU_LIMIT=0.75
BACKEND_MEMORY_LIMIT=768M
FRONTEND_CPU_LIMIT=0.50
FRONTEND_MEMORY_LIMIT=512M

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_SITE_URL=https://dev.vsocintern.online
OPENROUTER_APP_NAME=Vinhomes AI Real Estate Advisor

# Alternative: official OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Alternative: any OpenAI-compatible gateway
# LLM_PROVIDER=custom
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
LANGCHAIN_TRACING_V2=false
