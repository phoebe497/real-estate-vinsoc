# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.freemodel.dev/v1
# Use any chat model supported by your provider/base_url.
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ---- OpenRouter ----
# Chat uses LLM_* / OPENROUTER_* according to LLM_PROVIDER.
# Embeddings can use OpenRouter with model openai/text-embedding-3-small.
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
RAG_EMBEDDING_PROVIDER=openrouter

# ---- Database ----
# Docker Compose database bootstrap values.
POSTGRES_DB=ocean_park
POSTGRES_USER=ocean_app
POSTGRES_PASSWORD=replace-with-a-local-only-password

# Local development default. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./app.db
AUTO_CREATE_TABLES=true
AUTO_SEED_CATALOG=true
# Direct PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://ocean_app:your_password@localhost:5432/ocean_park

# ---- Dashboard Authentication ----
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@oceanpark.vn
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=Quản trị Ocean Park

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- RAG Retrieval ----
# legacy = JSON rollback path, pgvector = PostgreSQL full-text + pgvector hybrid retrieval.
RAG_PROVIDER=legacy
RAG_TOP_K=5
RAG_VECTOR_TOP_K=12
RAG_LEXICAL_TOP_K=12
RAG_MIN_SCORE=0.05
RAG_CONTEXT_TOKEN_BUDGET=1200
RAG_RRF_K=60
RAG_VECTOR_WEIGHT=0.6
RAG_LEXICAL_WEIGHT=0.4
RAG_DOMAIN_BOOST=0.08
RAG_METADATA_BOOST=0.12
RAG_FRESHNESS_BOOST=0.04
RAG_STALE_MONTHS=6

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
SQLALCHEMY_ECHO=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=replace-with-your-ai-log-key
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Chat gating V2 (BAN_THIET_KE_V2 Muc 5.1)
FREE_MESSAGE_LIMIT=3
CHAT_RATE_LIMIT_PER_MINUTE=5
CHAT_IP_RATE_LIMIT_PER_MINUTE=30
CUSTOMER_SCORE_RATE_LIMIT_PER_MINUTE=10
LOGIN_IP_RATE_LIMIT_PER_MINUTE=10
LOGIN_ACCOUNT_RATE_LIMIT_PER_MINUTE=5
